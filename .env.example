# Copiá este archivo a .env y completá los valores. NUNCA subas el .env real.
PORT=3000
# Si DATABASE_URL está vacío, el backend usa una base en memoria (solo para desarrollo local).
DATABASE_URL=
# Cadena larga y aleatoria. Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# URL del frontend permitida por CORS (en producción, la de Netlify). Para local: *
CORS_ORIGIN=*
# Opcional: crea un usuario administrador al iniciar si no existe.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
